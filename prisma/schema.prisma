generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  username             String    @unique
  passwordHash         String?
  appleId              String?   @unique
  googleId             String?   @unique
  firstName            String?
  lastName             String?
  avatarUrl            String?
  dateOfBirth          DateTime?
  gender               String?
  location             String?
  bio                  String?
  stylePreferences     String[]
  favoriteBrands       String[]
  preferredSizes       Json?
  onboardingCompleted  Boolean   @default(false)
  profileIsPrivate     Boolean   @default(false)
  refreshTokenHash     String?
  resetTokenHash       String?
  resetTokenExpiry     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  swipes                 Swipe[]
  collections            Collection[]
  deviceTokens           DeviceToken[]
  following              Follow[]       @relation("UserFollowing")
  followers              Follow[]       @relation("UserFollowers")
  friendRequestsSent     FriendRequest[] @relation("FriendRequestFrom")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestTo")
  blocksInitiated        UserBlock[]    @relation("UserBlocks")
  blocksReceived         UserBlock[]    @relation("UserBlockedBy")
}

enum FollowStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Follow {
  id          String       @id @default(uuid())
  followerId  String
  followeeId  String
  status      FollowStatus
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  follower User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("UserFollowers", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId])
  @@index([followerId])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model FriendRequest {
  id         String               @id @default(uuid())
  fromUserId String
  toUserId   String
  status     FriendRequestStatus
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  fromUser User @relation("FriendRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@index([fromUserId])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@index([blockerId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @default("ios")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ClothingItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  brand       String
  category    String
  subcategory String?
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  imageUrl    String
  images      String[]
  colors      String[]
  sizes       String[]
  tags        String[]
  gender      String?
  productType String?
  sourceUrl        String?
  metadata         Json?
  retailer         String?
  externalId       String?
  manufacturerCode String?
  lastVerifiedAt   DateTime?
  active           Boolean  @default(true)
  hasNobg          Boolean?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  swipes          Swipe[]
  collectionItems CollectionItem[]

  @@unique([retailer, externalId])
  @@index([category])
  @@index([brand])
  @@index([gender])
  @@index([productType])
  @@index([active])
  @@index([hasNobg])
  @@index([retailer])
}

enum SwipeAction {
  LOVE
  LIKE
  DISLIKE
  NEUTRAL
}

model Swipe {
  id        String      @id @default(uuid())
  userId    String
  itemId    String
  action    SwipeAction
  createdAt DateTime    @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ClothingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
}

model Collection {
  id        String   @id @default(uuid())
  userId    String
  name      String
  coverUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String   @id @default(uuid())
  collectionId String
  itemId       String
  addedAt      DateTime @default(now())

  collection Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  item       ClothingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([collectionId, itemId])
}

model ScrapedRaw {
  id        String   @id @default(uuid())
  sourceUrl String   @unique
  retailer  String
  html      String
  scrapedAt DateTime @default(now())
  processed Boolean  @default(false)

  @@index([retailer])
  @@index([processed])
}
