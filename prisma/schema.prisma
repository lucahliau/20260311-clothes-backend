generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  username             String    @unique
  passwordHash         String?
  appleId              String?   @unique
  googleId             String?   @unique
  firstName            String?
  lastName             String?
  avatarUrl            String?
  dateOfBirth          DateTime?
  gender               String?
  location             String?
  bio                  String?
  stylePreferences     String[]
  favoriteBrands       String[]
  preferredSizes       Json?
  onboardingCompleted  Boolean   @default(false)
  profileIsPrivate     Boolean   @default(false)
  refreshTokenHash     String?
  resetTokenHash       String?
  resetTokenExpiry     DateTime?
  emailVerified              Boolean   @default(false)
  emailVerificationTokenHash String?   @unique
  emailVerificationExpiry    DateTime?
  failedLoginAttempts        Int       @default(0)
  lockedUntil                DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  swipes                 Swipe[]
  collections            Collection[]
  deviceTokens           DeviceToken[]
  sessions               Session[]
  following              Follow[]       @relation("UserFollowing")
  followers              Follow[]       @relation("UserFollowers")
  friendRequestsSent     FriendRequest[] @relation("FriendRequestFrom")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestTo")
  blocksInitiated        UserBlock[]    @relation("UserBlocks")
  blocksReceived         UserBlock[]    @relation("UserBlockedBy")
  conversationParticipants ConversationParticipant[]
  sentMessages           Message[]
  reportsFiled           UserReport[]   @relation("ReportsFiled")
  reportsReceived        UserReport[]   @relation("ReportsReceived")
}

/// A user-filed abuse report against another user (App Store guideline 1.2
/// requires a report mechanism alongside blocking). Reviewed out-of-band;
/// `status` moves open → reviewed/actioned via scripts/list-reports.ts.
model UserReport {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String
  reason         String
  details        String?
  status         String   @default("open")
  createdAt      DateTime @default(now())

  reporter     User @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reportedUserId])
  @@index([status, createdAt])
}

/// Per-device refresh-token session. Replaces the single `User.refreshTokenHash`
/// slot so concurrent refreshes don't overwrite each other and multi-device
/// logins don't invalidate each other's sessions.
model Session {
  id                       String    @id @default(uuid())
  userId                   String
  deviceId                 String
  refreshTokenHash         String    @unique
  previousRefreshTokenHash String?   @unique
  rotatedAt                DateTime?
  expiresAt                DateTime
  lastSeenAt               DateTime  @default(now())
  createdAt                DateTime  @default(now())
  userAgent                String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([expiresAt])
}

enum FollowStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Follow {
  id          String       @id @default(uuid())
  followerId  String
  followeeId  String
  status      FollowStatus
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  follower User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("UserFollowers", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId])
  @@index([followerId])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model FriendRequest {
  id         String               @id @default(uuid())
  fromUserId String
  toUserId   String
  status     FriendRequestStatus
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  fromUser User @relation("FriendRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@index([fromUserId])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@index([blockerId])
}

model Conversation {
  id           String                    @id @default(uuid())
  pairKey      String                    @unique
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String?
  itemId         String?
  deletedAt      DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  item         ClothingItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model DeviceToken {
  id             String    @id @default(uuid())
  userId         String
  token          String    @unique
  platform       String    @default("ios")
  createdAt      DateTime  @default(now())
  lastSuccessAt  DateTime?
  failureCount   Int       @default(0)
  lastFailureAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ClothingItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  brand       String
  category    String
  subcategory String?
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  imageUrl    String
  images      String[]
  colors      String[]
  sizes       String[]
  tags        String[]
  gender      String?
  productType String?
  sourceUrl        String?
  metadata         Json?
  retailer         String?
  externalId       String?
  manufacturerCode String?
  lastVerifiedAt   DateTime?
  active           Boolean  @default(true)
  hasNobg          Boolean?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  swipes          Swipe[]
  collectionItems CollectionItem[]
  messages        Message[]
  embeddings      ItemEmbedding[]

  @@unique([retailer, externalId])
  @@index([category])
  @@index([brand])
  @@index([gender])
  @@index([productType])
  @@index([active])
  @@index([hasNobg])
  @@index([retailer])
}

enum SwipeAction {
  LOVE
  LIKE
  DISLIKE
  NEUTRAL
}

model Swipe {
  id        String      @id @default(uuid())
  userId    String
  itemId    String
  action    SwipeAction
  createdAt DateTime    @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ClothingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
}

model Collection {
  id        String   @id @default(uuid())
  userId    String
  name      String
  coverUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String   @id @default(uuid())
  collectionId String
  itemId       String
  addedAt      DateTime @default(now())

  collection Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  item       ClothingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([collectionId, itemId])
}

model ScrapedRaw {
  id        String   @id @default(uuid())
  sourceUrl String   @unique
  retailer  String
  html      String
  scrapedAt DateTime @default(now())
  processed Boolean  @default(false)

  @@index([retailer])
  @@index([processed])
}

/// Per-item embedding vectors (pgvector). `vector` column is vector(512) in DB for CLIP ViT-B-32 image embeddings.
model ItemEmbedding {
  id         String   @id @default(uuid())
  itemId     String
  model      String
  dim        Int
  vector     Unsupported("vector(512)")
  embeddedAt DateTime @default(now())

  item ClothingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, model])
  @@index([model])
  @@index([itemId])
}
