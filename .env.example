# Copy to .env and fill in secrets. Never commit .env.
# Every variable here is validated in src/lib/env.ts.

# --- Server ---
PORT=3000
NODE_ENV=development
# Public URL of this API (no trailing slash). For production on Railway:
# APP_URL=https://20260311-clothes-backend-production.up.railway.app
# For local-only dev, localhost is fine; reset emails will point at localhost.
APP_URL=http://localhost:3000
# Set to 1 when behind a reverse proxy outside production (NODE_ENV=production already enables it).
# TRUST_PROXY=1

# --- Database (Supabase Postgres; shared with the content crawler) ---
DATABASE_URL=postgresql://user:pass@host:5432/db

# --- Auth ---
JWT_SECRET=replace-with-long-random-string-at-least-16-chars
JWT_REFRESH_SECRET=replace-with-long-random-string-at-least-16-chars
# Sign in with Apple / Google — must match the token `aud` claim the app sends.
# APPLE_CLIENT_ID=com.your.bundle
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
# Optional; defaults to onboarding@resend.dev. Use your verified domain in production.
# RESEND_FROM_EMAIL="Clothes <noreply@yourdomain.com>"

# --- Storage ---
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=service-role-key
# R2_PUBLIC_URL=https://images.example.com

# --- Push notifications (APNS) ---
# APNS_KEY_ID=ABC123
# APNS_TEAM_ID=DEF456
# APNS_BUNDLE_ID=com.your.bundle
# APNS_KEY_PATH=./AuthKey_ABC123.p8   # .p8 keys are gitignored; never commit them

# --- Universal Links (AASA) ---
# APPLE_UNIVERSAL_LINK_APP_ID=ABCDE12345.com.your.bundle
# (or set APNS_TEAM_ID + APNS_BUNDLE_ID instead)

# --- CORS (only if a browser calls this API; native iOS does not need it) ---
# CORS_ORIGIN=https://your-web-app.com

# --- Observability (all optional; Sentry is a no-op without a DSN) ---
# SENTRY_DSN=https://xxx@oXXXX.ingest.sentry.io/XXXX
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
# LOG_LEVEL=info
