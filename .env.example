# Copy to .env and fill in secrets. Never commit .env.

# Server
PORT=3000
NODE_ENV=development

# Public URL of this API (no trailing slash).
# For production on Railway, use your real HTTPS origin, e.g.:
# APP_URL=https://20260311-clothes-backend-production.up.railway.app
# For local-only dev, http://localhost:3000 is fine; reset emails will point at localhost.
APP_URL=http://localhost:3000

JWT_SECRET=replace-with-long-random-string-at-least-16-chars
JWT_REFRESH_SECRET=replace-with-long-random-string-at-least-16-chars

RESEND_API_KEY=re_xxxxxxxx

# Optional: Universal Links (Apple App Site Association)
# APPLE_UNIVERSAL_LINK_APP_ID=ABCDE12345.com.your.bundle
# Or use APNS_TEAM_ID + APNS_BUNDLE_ID instead.

DATABASE_URL=postgresql://user:pass@host:5432/db
